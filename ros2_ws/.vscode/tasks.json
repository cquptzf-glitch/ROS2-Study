{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ROS 2: colcon build (RelWithDebInfo + clangd)",
      "type": "shell",
      "command": "source /opt/ros/${env:ROS_DISTRO:-jazzy}/setup.bash && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ROS 2: colcon build (Debug for GDB)",
      "type": "shell",
      "command": "source /opt/ros/${env:ROS_DISTRO:-jazzy}/setup.bash && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ROS 2: colcon test (chassis_core)",
      "type": "shell",
      "command": "source /opt/ros/${env:ROS_DISTRO:-jazzy}/setup.bash && source install/setup.bash && colcon test --packages-select chassis_core --event-handlers console_direct+",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test"
    }
  ]
}
