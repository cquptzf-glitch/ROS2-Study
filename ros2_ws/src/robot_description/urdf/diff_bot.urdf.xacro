<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="industrial_diff_bot">
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_sep" value="0.42"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.52 0.36 0.14"/></geometry>
      <material name="slate"><color rgba="0.18 0.24 0.32 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.52 0.36 0.14"/></geometry>
    </collision>
    <inertial>
      <mass value="18.0"/>
      <inertia ixx="0.22" ixy="0.0" ixz="0.0" iyy="0.43" iyz="0.0" izz="0.59"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="prefix y_offset">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark_rubber"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="1.5"/>
        <inertia ixx="0.0026" ixy="0.0" ixz="0.0" iyy="0.0026" iyz="0.0" izz="0.0048"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" y_offset="${wheel_sep / 2.0}"/>
  <xacro:drive_wheel prefix="right" y_offset="${-wheel_sep / 2.0}"/>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.05"/></geometry>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.20 0.0 0.10" rpy="0 0 0"/>
  </joint>

  <ros2_control name="DiffBotHardwareSystem" type="system">
    <hardware>
      <plugin>diff_hw_interface/DiffBotSystemHardware</plugin>
      <param name="can_interface">can0</param>
      <param name="left_motor_id">1</param>
      <param name="right_motor_id">2</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
